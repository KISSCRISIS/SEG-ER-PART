{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seg.local/schemas/algorithm-metadata.schema.json",
  "title": "SEG Algorithm Metadata",
  "description": "Links one management/diagnostic algorithm node to its canonical topicId.",
  "type": "object",
  "required": ["algorithmId", "topicId", "type", "priority"],
  "properties": {
    "algorithmId": { "type": "string", "pattern": "^ALG_[A-Z0-9_]+$", "examples": ["ALG_STEMI"] },
    "topicId": {
      "type": "string",
      "pattern": "^EM_[A-Z]+_[A-Z0-9_]+$",
      "description": "Must exist in medical-content/knowledge-graph/topic-registry.json",
      "examples": ["EM_CARDIO_ACS"]
    },
    "type": { "enum": ["Management Algorithm", "Diagnostic Algorithm", "Resuscitation Algorithm"] },
    "priority": { "enum": ["Very High", "High", "Medium", "Low"] }
  },
  "additionalProperties": true
}

# Copy to .env for local configuration. Never commit your real .env file.
NODE_ENV=development
PORT=3000
# Development only: start-development.mjs generates a process-local secret if omitted.
JWT_SECRET=
SEG_LOCAL_WORKSPACE=true
SEG_LOCAL_EMAIL_LOGIN=true
SEG_LOCAL_DATA_DIR=.seg-local-data
# Optional in local workspace mode; required for hosted production.
DATABASE_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# Body size includes Base64-encoded PDF imports (35 MiB PDF maximum).
BODY_SIZE_LIMIT=48mb
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=30
TRUST_PROXY=false

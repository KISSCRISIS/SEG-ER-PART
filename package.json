{
  "name": "seg-phase1",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "desktop": "electron desktop/main.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/build-desktop.mjs && electron-builder --config electron-builder.json --win",
    "dev": "node --watch --import tsx scripts/start-development.mjs",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node scripts/start-production.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ui": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/run-ui-tests.mjs",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
    "ci": "pnpm lint && pnpm check && pnpm test && pnpm repo:hygiene && pnpm build",
    "repo:hygiene": "node scripts/check-repository-hygiene.mjs",
    "audit:final-package": "node scripts/audit-final-package.mjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "index:medical-systems": "tsx scripts/build-medical-systems-index.ts",
    "index:global-layer": "tsx scripts/build-global-learning-layer.ts",
    "index:topic-graph": "tsx scripts/build-topic-graph.ts",
    "index:content-mapping": "tsx scripts/build-content-mapping.ts",
    "index:book-mapping": "tsx scripts/build-book-mapping.ts",
    "index:qbank-mapping": "tsx scripts/build-qbank-mapping.ts",
    "android:sync": "capacitor sync",
    "android:open": "capacitor open android",
    "android:build": "cross-env CAPACITOR_BUILD=true vite build && capacitor sync android",
    "android:dev": "capacitor run android"
  },
  "dependencies": {
